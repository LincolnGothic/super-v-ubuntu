msgstr "Se registra el texto copiado después de activar la extensión."

#, javascript-format
msgid "Tone: %s"
msgstr "Tono: %s"

msgid "Travel & Places"
msgstr "Viajes y lugares"

msgid "Turn off to copy selections without sending a paste shortcut."
msgstr "Desactívalo para copiar selecciones sin enviar un atajo de pegar."

msgid "Turning this off removes the saved file; current memory is retained."
msgstr "Desactivarlo elimina el archivo guardado; el historial en memoria se conserva."

msgid "Units"
msgstr "Unidades"

msgid "Unpin entry"
msgstr "Desfijar elemento"

msgid "Use a shortcut such as <Super>v or <Control><Alt>v."
msgstr "Usa un atajo como <Super>v o <Control><Alt>v."

msgid "Use exact desktop application IDs (including .desktop where present) or WM classes. Clipboard origin cannot always be identified."
msgstr "Usa los identificadores exactos de aplicaciones (incluido .desktop cuando corresponda) o clases WM. No siempre se puede identificar el origen del portapapeles."

msgid "You can pin up to 100 entries."
msgstr "Puedes fijar hasta 100 elementos."

msgid "Your recently used emoji will appear here."
msgstr "Tus emojis recientes aparecerán aquí."

